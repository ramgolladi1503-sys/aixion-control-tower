{
  "aixion-mobile-approval": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|manage_task|schedule|ask_permission|invoke_subagent|define_subagent|send_message|manage_subagents|generate_image",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /absolute/path/to/aixion-control-tower/integrations/antigravity/aixion_pre_tool_hook.py",
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
