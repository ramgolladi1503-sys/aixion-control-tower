# Copy to a protected environment file outside source control.
# Never commit real values.

AIXION_PROFILE=production
AIXION_AUTH_ENABLED=true
AIXION_TRUST_ENFORCEMENT=true
# Production API instances do not poll outboxes; scheduled one-shot workers own dispatch.
AIXION_OUTBOX_DISPATCH_MODE=scheduled
# Keep this DSN in a secret manager; configuring it does not enable PostgreSQL persistence.
AIXION_POSTGRES_DSN=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/aixion_control_tower?sslmode=verify-full
AIXION_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
AIXION_POSTGRES_STATEMENT_TIMEOUT_MS=15000
AIXION_POSTGRES_LOCK_TIMEOUT_MS=3000
AIXION_POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=15000
AIXION_POSTGRES_POOL_MIN_SIZE=2
AIXION_POSTGRES_POOL_MAX_SIZE=12
AIXION_POSTGRES_POOL_WAIT_TIMEOUT_SECONDS=5
AIXION_POSTGRES_POOL_MAX_WAITING=20
# Probe pool/schema at startup only; this does not switch API persistence from SQLite.
AIXION_POSTGRES_RUNTIME_PROBE_ENABLED=false
# Reject larger connector webhook bodies before authentication/state mutation; 1 KiB–10 MiB.
AIXION_CONNECTOR_WEBHOOK_MAX_BODY_BYTES=1048576
# Retry repair of approval-to-AgentRun scheduling gaps; 1–300 seconds (default 60).
AIXION_APPROVAL_RECOVERY_POLL_SECONDS=60
# Experimental partial binding only; requires the runtime probe above to be true.
# This moves auth rate-limit counters to PostgreSQL, not the complete auth lifecycle.
AIXION_POSTGRES_AUTH_RATE_LIMITS_ENABLED=false
AIXION_PUBLIC_BASE_URL=https://aixion.example.com

# Generate at least 32 random bytes and store through a secret manager.
AIXION_LEASE_SIGNING_KEY=replace-with-secret-manager-value

# Choose one GitHub authentication method.
# Preferred: short-lived GitHub App installation tokens.
AIXION_GITHUB_APP_ID=
AIXION_GITHUB_APP_INSTALLATION_ID=
AIXION_GITHUB_APP_PRIVATE_KEY=

# Temporary compatibility option. Leave empty when GitHub App credentials are configured.
GITHUB_TOKEN=

# Mobile push notifications use FCM HTTP v1 and Google Application Default Credentials.
AIXION_FCM_PROJECT_ID=replace-with-firebase-project-id
# Keep disabled until the complete PostgreSQL application path and FCM outbox producer are certified.
AIXION_PUSH_DISPATCH_ENABLED=false
AIXION_PUSH_DISPATCH_POLL_SECONDS=5
AIXION_PUSH_MAX_ATTEMPTS=5
AIXION_PUSH_RETRY_BASE_SECONDS=15
AIXION_PUSH_RETRY_MAX_SECONDS=300
AIXION_PUSH_LEASE_SECONDS=60
# Verification email uses SMTP STARTTLS and an encrypted local outbox adapter.
# Production startup remains blocked until the complete PostgreSQL application path is implemented.
AIXION_EMAIL_DISPATCH_ENABLED=true
AIXION_EMAIL_SMTP_HOST=smtp.example.com
AIXION_EMAIL_SMTP_PORT=587
AIXION_EMAIL_SMTP_USERNAME=
AIXION_EMAIL_SMTP_PASSWORD=
AIXION_EMAIL_FROM=verify@example.com
# Generate 32 random bytes and encode as 64 hex characters; store in a secret manager.
AIXION_EMAIL_OUTBOX_KEY=replace-with-64-hex-character-secret # gitleaks:allow
AIXION_EMAIL_DISPATCH_POLL_SECONDS=5
AIXION_EMAIL_MAX_ATTEMPTS=5
AIXION_EMAIL_RETRY_BASE_SECONDS=15
AIXION_EMAIL_RETRY_MAX_SECONDS=300
AIXION_EMAIL_LEASE_SECONDS=60
AIXION_EMAIL_SMTP_TIMEOUT_SECONDS=10

# HMAC key used to store only opaque authentication rate-limit bucket IDs.
# Generate 32 random bytes and encode as 64 hex characters.
AIXION_AUTH_RATE_LIMIT_HMAC_KEY=replace-with-64-hex-character-secret # gitleaks:allow
AIXION_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AIXION_AUTH_REGISTER_LIMIT_PER_IP=10
AIXION_AUTH_RESEND_LIMIT_PER_IP=10
AIXION_AUTH_RESEND_LIMIT_PER_EMAIL=1
AIXION_AUTH_LOGIN_LIMIT_PER_IP=30
AIXION_AUTH_VERIFY_LIMIT_PER_IP=30
AIXION_AUTH_VERIFY_LIMIT_PER_EMAIL=5

# Dedicated Prometheus credential. Bind it to exactly one account workspace;
# use the same token in secrets/aixion_metrics_token, mounted only by Prometheus.
# Generate at least 32 random bytes and keep both values in protected secret storage.
AIXION_METRICS_TOKEN=replace-with-at-least-32-random-bytes
AIXION_METRICS_WORKSPACE_ID=replace-with-account-workspace-id

# The stateless scheduler authenticates to the API with a short-lived OWNER session token.
AIXION_OWNER_TOKEN=replace-with-short-lived-owner-session-token

# Grafana administrator password.
GRAFANA_ADMIN_PASSWORD=replace-with-secret-manager-value

# Optional explicit settings.
AIXION_ALLOW_UNAUTHENTICATED_EXTERNAL_AGENT_DEMO=false

# PostgreSQL RUN_VALIDATION remains disabled until trusted bundle resolution,
# isolated container runtime, durable claim, and completion verification are deployed.
AIXION_POSTGRES_RUN_VALIDATION_ENABLED=false
# Required before enabling RUN_VALIDATION: immutable image reference pinned by digest.
# Format: registry/repository:tag@sha256:<64 lowercase hex characters>.
# Mutable tags, missing values, and invalid digests fail closed.
AIXION_VALIDATION_CONTAINER_IMAGE=
