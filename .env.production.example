# Copy to a protected environment file outside source control.
# Never commit real values.

AIXION_PROFILE=production
AIXION_AUTH_ENABLED=true
AIXION_TRUST_ENFORCEMENT=true
AIXION_DB_PATH=/app/runtime/aixion_control_tower.sqlite3
AIXION_PUBLIC_BASE_URL=https://aixion.example.com

# Generate at least 32 random bytes and store through a secret manager.
AIXION_LEASE_SIGNING_KEY=replace-with-secret-manager-value

# Choose one GitHub authentication method.
# Preferred: short-lived GitHub App installation tokens.
AIXION_GITHUB_APP_ID=
AIXION_GITHUB_APP_INSTALLATION_ID=
AIXION_GITHUB_APP_PRIVATE_KEY=

# Temporary compatibility option. Leave empty when GitHub App credentials are configured.
GITHUB_TOKEN=

# Mobile push notifications.
FCM_SERVER_KEY=replace-with-secret-manager-value

# The stateless scheduler authenticates to the API with a short-lived OWNER session token.
AIXION_OWNER_TOKEN=replace-with-short-lived-owner-session-token

# Grafana administrator password.
GRAFANA_ADMIN_PASSWORD=replace-with-secret-manager-value

# Optional explicit settings.
AIXION_ALLOW_UNAUTHENTICATED_EXTERNAL_AGENT_DEMO=false
