<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aixion.agent-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__AIXION_RELAY_EXECUTABLE__</string>
    <string>--config</string>
    <string>__AIXION_RELAY_CONFIG__</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>NetworkState</key>
    <true/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__AIXION_RELAY_LOG_DIR__/relay.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__AIXION_RELAY_LOG_DIR__/relay.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
